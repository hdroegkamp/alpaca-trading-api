# Copy this file to .env and fill in your Alpaca paper-trading credentials.
# Get keys from https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=your_key_here
APCA_API_SECRET_KEY=your_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# true = paper account (default), false = live trading account.
# Read by src/trading/execution/broker.py — flip only when you deliberately
# mean to trade with real money.
APCA_PAPER=true
